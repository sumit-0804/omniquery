 {
  "type": "sql",
  "t": 1.657,
  "query": "SELECT\n    to_char(dropoff_time, 'YYYY-MM') AS month,\n    COUNT(*) AS completed_rides\nFROM\n    rides\nWHERE\n    status = 'completed'\n    AND dropoff_time >= '2025-01-01'\n    AND dropoff_time < '2026-01-01'\nGROUP BY\n    to_char(dropoff_time, 'YYYY-MM')\nORDER BY\n    month\nLIMIT 1000",
