# Copy to .env and fill in. Never commit .env.

# Postgres, used by feed_db.py and the SQL agent
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Model chain: Gemini -> Groq -> Cloudflare Workers AI. A 429, a 503 or a spent
# daily budget moves a call to the next provider.

# Primary
GEMINI_API_KEY=
GEMINI_RPM=12
GEMINI_TPM=200000
GEMINI_RPD=900

# Second: Groq free tier. Limits apply to each model separately.
# Tokens per day is the one that runs out first.
GROQ_API_KEY=
# GROQ_RPM=30
# GROQ_TPM=8000
# GROQ_RPD=1000
# GROQ_TPD=200000

# Last: Cloudflare Workers AI. Token needs the "Workers AI" read permission.
# The budget is counted in neurons, which the API reports on every response.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_NEURONS_PER_DAY=10000

# Router classifier only (utils/jev.py). Not part of the model chain.
OPENROUTER_API_KEY=

# Optional overrides
# HIGH_REASONING_EFFORT=high      # low | medium | high, for the "high" level models
# LLM_MAX_OUTPUT_TOKENS=8192      # too low and reasoning models return empty replies
# OMNIQUERY_PROVIDER=groq         # use only one provider: gemini | groq | cloudflare
