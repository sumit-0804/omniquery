# Copy to .env and fill in. Never commit .env.

# Demo Postgres: only feed_db.py, evals/make_big_schema.py and the integration tests
# read these. The agents query saved sources instead:
#   uv run omniquery --add-source rides postgresql://user:pass@localhost:5432/dbname
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Model chain: Groq -> Cloudflare Workers AI -> Gemini. A 429, a 503, a timeout or a
# spent daily budget moves a call to the next provider.

# First: Groq free tier. Limits apply to each model separately, and tokens per day
# (about 140 questions on qwen) is the one that runs out first.
GROQ_API_KEY=
# GROQ_RPM=30
# GROQ_TPM=8000
# GROQ_RPD=1000
# GROQ_TPD=200000

# Second: Cloudflare Workers AI. Token needs the "Workers AI" read permission.
# The budget is counted in neurons, reported on every response; resets at midnight UTC.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_NEURONS_PER_DAY=10000

# Last: Gemini. Limits differ per model, apply per Google Cloud project, and reset at
# midnight Pacific. Google shows your real limits only in AI Studio:
#   https://aistudio.google.com/rate-limit
# The defaults below come from third-party guides; replace them with yours.
GEMINI_API_KEY=
# GEMINI_LITE_MODEL=gemini-3.5-flash-lite
# GEMINI_LITE_RPM=15
# GEMINI_LITE_TPM=250000
# GEMINI_LITE_RPD=500
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# GEMINI_FLASH_RPM=10
# GEMINI_FLASH_TPM=250000
# GEMINI_FLASH_RPD=20

# Router: Jev (utils/jev_router.py) through OpenRouter. Without it, the LLM chain routes.
OPENROUTER_API_KEY=

# Optional overrides
# HIGH_REASONING_EFFORT=high      # low | medium | high, for the "high" level models
# LLM_MAX_OUTPUT_TOKENS=8192      # too low and reasoning models return empty replies
# OMNIQUERY_PROVIDER=groq         # use only one provider: groq | cloudflare | gemini
